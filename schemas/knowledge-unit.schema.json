{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Munger Partner Knowledge Unit",
  "type": "object",
  "required": ["id", "status", "kind", "title", "models", "source", "review"],
  "properties": {
    "id": {"type": "string", "pattern": "^KU-[0-9]{4,}$"},
    "status": {"enum": ["candidate", "verified", "rejected"]},
    "kind": {"enum": ["quote", "principle", "model", "case"]},
    "title": {"type": "string", "minLength": 2},
    "models": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source": {
      "type": "object",
      "required": ["tier", "speaker_or_author", "title", "locator"],
      "properties": {
        "tier": {"enum": ["primary", "secondary", "lead"]},
        "speaker_or_author": {"type": "string"},
        "title": {"type": "string"},
        "date": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "locator": {"type": "string"},
        "language": {"type": "string"}
      }
    },
    "review": {
      "type": "object",
      "required": ["context_checked", "attribution_checked", "duplicate_checked", "causality_checked", "reviewers"],
      "properties": {
        "context_checked": {"type": "boolean"},
        "attribution_checked": {"type": "boolean"},
        "duplicate_checked": {"type": "boolean"},
        "causality_checked": {"type": "boolean"},
        "reviewers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reviewed_at": {"type": ["string", "null"]},
        "rejection_reason": {"type": ["string", "null"]}
      }
    }
  }
}
